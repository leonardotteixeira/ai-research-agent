# Copy to .env and fill in as needed. Defaults below work out of the box —
# no API keys required (mock LLM decisions and mock search results are
# used; see README "Providers").

ENVIRONMENT=development

# When true (default), the LLM provider and search provider are both
# deterministic in-process mocks — no network calls, no cost. Set to false
# and fill in the keys below to run real research.
USE_MOCK_PROVIDERS=true

# LLM provider -- "openai" (default) or "anthropic". Only the matching
# API key below is required.
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_INPUT_PRICE_PER_1M=0.15
LLM_OUTPUT_PRICE_PER_1M=0.60

# Anthropic (Claude) -- used only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Search provider (Brave Search API — https://api.search.brave.com)
SEARCH_API_KEY=
SEARCH_API_BASE_URL=https://api.search.brave.com/res/v1/web/search

# Timeouts
PROVIDER_TIMEOUT_SECONDS=30
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_CONTENT_BYTES=1000000

# Default execution policy — see README "Limits" for what each one does.
DEFAULT_MAX_STEPS=8
DEFAULT_MAX_TOOL_CALLS=12
DEFAULT_MAX_SAME_TOOL_CALLS=3
DEFAULT_TOTAL_TIMEOUT_SECONDS=120
DEFAULT_PER_TOOL_TIMEOUT_SECONDS=20

LOG_LEVEL=INFO
